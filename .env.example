# Neon Postgres connection string (from the Neon dashboard or the Vercel
# Postgres integration). Powers the student registrations storage.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The single organizer access code for the /admin registrations page.
# Anyone who enters this code can view every student's details, so keep it
# private and hard to guess.
ADMIN_CODE=change-me-to-a-private-code

# Set this to the final deployed URL so social preview links are absolute.
SITE_URL=https://your-site-url.example
